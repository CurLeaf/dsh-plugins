{
  "name": "@qzsy/dsh-git-panel",
  "version": "0.2.0",
  "description": "A Git section for the right Sidebar: workspace changes, a commit box, stage/discard, a diff preview tab, and a commit graph — modelled on the Git module of the local Cursor IDE.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "author": "curleaf",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "sidebar",
    "source-control",
    "commit-graph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurLeaf/dsh-plugins.git",
    "directory": "packages/dsh-git-panel"
  },
  "homepage": "https://github.com/CurLeaf/dsh-plugins/tree/main/packages/dsh-git-panel#readme",
  "bugs": {
    "url": "https://github.com/CurLeaf/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
