{
  "name": "dsh-restart-button",
  "version": "0.1.0",
  "description": "A restart button inside the DSH account row (desktop sidebar and mobile drawer): one authenticated Host route restarts the dsh-web service, the browser half attaches a two-step confirm button to the avatar row.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "author": "curleaf",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "sidebar",
    "systemd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurLeaf/dsh-plugins.git",
    "directory": "packages/dsh-restart-button"
  },
  "homepage": "https://github.com/CurLeaf/dsh-plugins/tree/main/packages/dsh-restart-button#readme",
  "bugs": {
    "url": "https://github.com/CurLeaf/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
