{
  "name": "dsh-shell-ui",
  "version": "0.1.0",
  "description": "Two pure-cosmetic DSH shell patches in one bundle: macOS-style grouped settings cards, and a left rail that folds non-navigation panels into 更多.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-account",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "curleaf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurLeaf/dsh-plugins.git",
    "directory": "packages/dsh-shell-ui"
  },
  "homepage": "https://github.com/CurLeaf/dsh-plugins/tree/main/packages/dsh-shell-ui#readme",
  "bugs": {
    "url": "https://github.com/CurLeaf/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "settings",
    "sidebar"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
