{
  "name": "dsh-file-tree-menu",
  "version": "0.1.0",
  "description": "Right-click menu for the workspace file tree: add to the conversation, reveal in the file manager, copy the name / relative path / absolute path, rename, and delete.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "author": "curleaf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CurLeaf/dsh-plugins.git",
    "directory": "packages/dsh-file-tree-menu"
  },
  "homepage": "https://github.com/CurLeaf/dsh-plugins/tree/main/packages/dsh-file-tree-menu#readme",
  "bugs": {
    "url": "https://github.com/CurLeaf/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
